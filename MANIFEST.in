include README.md
include LICENSE
include NOTICE
include CITATION.cff
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include INTEGRATION.md
include pyproject.toml
include asv.conf.json
recursive-include benchmarks *.py *.txt
recursive-include docs *.md *.jpg *.png *.pdf
recursive-include docs/site *.csv
recursive-include docs/site/_static/benchmarks *.json *.svg *.zip *.sha256
exclude docs/sources/04_Fertilizer.pdf
exclude docs/sources/165357805552.pdf
exclude docs/sources/215057776303.pdf
exclude docs/sources/215726931002.pdf
exclude docs/sources/yaravita-micronutrients-products-and-services-guide.pdf
exclude docs/sources/mccleskey_nordstrom_etal_2012.pdf
# Every manufacturer PDF stays local-only until redistribution is permitted.
recursive-exclude docs/sources *.pdf
recursive-include src/flahax *.py
recursive-include src/flahax/data *.json
recursive-include src/flahax/data *.md
recursive-include tests *.py
recursive-include tests/fixtures *.json *.pqi *.out *.sel *.screen *.dat *.md *.inp
recursive-include tools *.py *.ps1
include tools/requirements-benchmark-report.txt
recursive-include examples *.py *.md
prune examples/tutorial
global-exclude __pycache__
global-exclude *.py[cod]
prune docs/publication
prune docs/superpowers
