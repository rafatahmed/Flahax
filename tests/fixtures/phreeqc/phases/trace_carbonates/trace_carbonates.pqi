TITLE FlahaX trace_carbonates; 25 C fixed analytical oxidation states
SOLUTION 1
 temp 25
 pH 8.5
 units mol/kgw
 -water 1
 Zn 0.0001
 Cu(2) 0.0001
 Mn(2) 0.0001
 C(4) 0.002
 Na 0.01 charge
 Cl 0.01
EQUILIBRIUM_PHASES 1
 Smithsonite 0 0
 Malachite 0 0
 Rhodochrosite 0 0
SELECTED_OUTPUT
 -file trace_carbonates.sel
 -reset false
 -high_precision true
 -pH true
 -ionic_strength true
 -charge_balance true
 -percent_error true
 -water true
 -totals Zn Cu(2) Mn(2) C(4) Na Cl
 -molalities CO3-2 Cl- Cu+2 H+ Na+ Zn+2 OH- ZnOH+ Zn(OH)2 Zn(OH)3- Zn(OH)4-2 CuOH+ Cu(OH)2 Cu(OH)3- Cu(OH)4-2 Cu2(OH)2+2 MnOH+ Mn(OH)3- Mn(OH)4-2 ZnCl+ ZnCl2 ZnCl3- ZnCl4-2 ZnOHCl CuCl+ CuCl2 CuCl3- CuCl4-2 MnCl+ MnCl2 MnCl3- HCO3- H2CO3 ZnCO3 ZnHCO3+ CuCO3 CuHCO3+ Cu(CO3)2-2 MnHCO3+ NaCO3- NaHCO3 Mn+2
 -activities CO3-2 Cl- Cu+2 H+ Na+ Zn+2 OH- ZnOH+ Zn(OH)2 Zn(OH)3- Zn(OH)4-2 CuOH+ Cu(OH)2 Cu(OH)3- Cu(OH)4-2 Cu2(OH)2+2 MnOH+ Mn(OH)3- Mn(OH)4-2 ZnCl+ ZnCl2 ZnCl3- ZnCl4-2 ZnOHCl CuCl+ CuCl2 CuCl3- CuCl4-2 MnCl+ MnCl2 MnCl3- HCO3- H2CO3 ZnCO3 ZnHCO3+ CuCO3 CuHCO3+ Cu(CO3)2-2 MnHCO3+ NaCO3- NaHCO3 Mn+2
 -si Zincite Cu(OH)2 Tenorite Pyrochroite Halite Smithsonite Malachite Rhodochrosite
 -equilibrium_phases Smithsonite Malachite Rhodochrosite
END
