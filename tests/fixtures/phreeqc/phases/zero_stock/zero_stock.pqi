TITLE FlahaX zero_stock; 25 C fixed analytical oxidation states
SOLUTION 1
 temp 25
 pH 6
 units mol/kgw
 -water 1
 Ca 1e-08
 C(4) 1e-08
 Na 0.01 charge
 Cl 0.01
EQUILIBRIUM_PHASES 1
 Calcite 0 0
SELECTED_OUTPUT
 -file zero_stock.sel
 -reset false
 -high_precision true
 -pH true
 -ionic_strength true
 -charge_balance true
 -percent_error true
 -water true
 -totals Ca C(4) Na Cl
 -molalities CO3-2 Ca+2 Cl- H+ Na+ OH- CaOH+ HCO3- H2CO3 CaHCO3+ CaCO3 NaCO3- NaHCO3
 -activities CO3-2 Ca+2 Cl- H+ Na+ OH- CaOH+ HCO3- H2CO3 CaHCO3+ CaCO3 NaCO3- NaHCO3
 -si Halite Calcite
 -equilibrium_phases Calcite
END
