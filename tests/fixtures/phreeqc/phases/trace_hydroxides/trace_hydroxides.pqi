TITLE FlahaX trace_hydroxides; 25 C fixed analytical oxidation states
SOLUTION 1
 temp 25
 pH 8
 units mol/kgw
 -water 1
 Fe(3) 0.0001
 Zn 0.0001
 Cu(2) 0.0001
 Mn(2) 0.0001
 Na 0.01 charge
 Cl 0.01
EQUILIBRIUM_PHASES 1
 Ferrihydrite 0 0
 Zincite 0 0
 Cu(OH)2 0 0
 Pyrochroite 0 0
SELECTED_OUTPUT
 -file trace_hydroxides.sel
 -reset false
 -high_precision true
 -pH true
 -ionic_strength true
 -charge_balance true
 -percent_error true
 -water true
 -totals Fe(3) Zn Cu(2) Mn(2) Na Cl
 -molalities Cl- Cu+2 Fe+3 H+ Na+ Zn+2 OH- ZnOH+ Zn(OH)2 Zn(OH)3- Zn(OH)4-2 CuOH+ Cu(OH)2 Cu(OH)3- Cu(OH)4-2 Cu2(OH)2+2 FeOH+2 Fe(OH)2+ Fe(OH)3 Fe(OH)4- Fe2(OH)2+4 Fe3(OH)4+5 MnOH+ Mn(OH)3- Mn(OH)4-2 ZnCl+ ZnCl2 ZnCl3- ZnCl4-2 ZnOHCl CuCl+ CuCl2 CuCl3- CuCl4-2 FeCl+2 FeCl2+ FeCl3 MnCl+ MnCl2 MnCl3- Mn+2
 -activities Cl- Cu+2 Fe+3 H+ Na+ Zn+2 OH- ZnOH+ Zn(OH)2 Zn(OH)3- Zn(OH)4-2 CuOH+ Cu(OH)2 Cu(OH)3- Cu(OH)4-2 Cu2(OH)2+2 FeOH+2 Fe(OH)2+ Fe(OH)3 Fe(OH)4- Fe2(OH)2+4 Fe3(OH)4+5 MnOH+ Mn(OH)3- Mn(OH)4-2 ZnCl+ ZnCl2 ZnCl3- ZnCl4-2 ZnOHCl CuCl+ CuCl2 CuCl3- CuCl4-2 FeCl+2 FeCl2+ FeCl3 MnCl+ MnCl2 MnCl3- Mn+2
 -si Zincite Cu(OH)2 Tenorite Ferrihydrite Goethite Pyrochroite Halite
 -equilibrium_phases Ferrihydrite Zincite Cu(OH)2 Pyrochroite
END
