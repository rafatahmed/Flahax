TITLE FlahaX ferrous_phases; 25 C fixed analytical oxidation states
SOLUTION 1
 temp 25
 pH 7
 units mol/kgw
 -water 1
 Fe(2) 0.0001
 P 0.001
 C(4) 0.001
 Na 0.01 charge
 Cl 0.01
EQUILIBRIUM_PHASES 1
 Vivianite 0 0
 Siderite 0 0
 Fe(OH)2 0 0
SELECTED_OUTPUT
 -file ferrous_phases.sel
 -reset false
 -high_precision true
 -pH true
 -ionic_strength true
 -charge_balance true
 -percent_error true
 -water true
 -totals Fe(2) P C(4) Na Cl
 -molalities CO3-2 Cl- H+ Na+ PO4-3 OH- FeOH+ Fe(OH)2 Fe(OH)3- HPO4-2 H2PO4- H3PO4 FeH2PO4+ FeHPO4 NaHPO4- HCO3- H2CO3 FeHCO3+ NaCO3- NaHCO3 Fe+2
 -activities CO3-2 Cl- H+ Na+ PO4-3 OH- FeOH+ Fe(OH)2 Fe(OH)3- HPO4-2 H2PO4- H3PO4 FeH2PO4+ FeHPO4 NaHPO4- HCO3- H2CO3 FeHCO3+ NaCO3- NaHCO3 Fe+2
 -si Fe(OH)2 Halite Siderite Vivianite
 -equilibrium_phases Vivianite Siderite Fe(OH)2
END
