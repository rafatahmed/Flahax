# FlahaX 25 C chelate extension. Appended verbatim to PHREEQC 3.8.6
# minteq.v4.dat; it does not modify the base database.
# Dtp and Edd are isolated custom PHREEQC components whose aqueous master
# species are Dtp-5 and Edd-4; no native minteq component is overridden.
SOLUTION_MASTER_SPECIES
    Dtp  Dtp-5  0  C14H23N3O10  393.35
    Edd  Edd-4  0  C18H20N2O6  360.36
SOLUTION_SPECIES
Dtp-5 = Dtp-5
    log_k 0
Dtp-5 + H+ = HDtp-4
    log_k 10.48
Dtp-5 + 2 H+ = H2Dtp-3
    log_k 19.08
Dtp-5 + 3 H+ = H3Dtp-2
    log_k 23.36
Dtp-5 + 4 H+ = H4Dtp-
    log_k 25.96
Dtp-5 + 5 H+ = H5Dtp
    log_k 27.96
Fe+3 + Dtp-5 = FeDtp-2
    log_k 28.60
Edd-4 = Edd-4
    log_k 0
Edd-4 + H+ = HEdd-3
    log_k 11.88
Edd-4 + 2 H+ = H2Edd-2
    log_k 22.68
Edd-4 + 3 H+ = H3Edd-
    log_k 31.35
Edd-4 + 4 H+ = H4Edd
    log_k 37.63
Fe+3 + Edd-4 = FeEdd-
    log_k 35.10
