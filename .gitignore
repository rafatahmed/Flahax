# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# Virtual environments
.venv/
.venv-*/
venv/
env/

# Packaging artifacts (verified release artifacts are kept outside the repository)
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl
*.tar.gz
pip-wheel-metadata/

# Local-only video tutorials: scripts, virtual environments and rendered media.
examples/tutorial/

# Local secrets, credentials and environment. Never commit tokens or keys.
.env
.env.*
.pypirc
*.pem
*.key
*.p12
*.pfx
*token*.txt
secrets/

# Editors, OS files and merge leftovers
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.orig
*.rej
*.bak

# PHREEQC creates empty scratch logs beside captures; evidence uses .screen/.out.
tests/fixtures/phreeqc/**/phreeqc.log

# User-supplied manufacturer references are local-only until redistribution
# permission is established; findings and SHA-256 hashes are versioned in
# docs/site/guide/source-sheet-review.md. This covers every PDF in docs/sources/.
docs/sources/*.pdf

# Internal design specs and plans (local only)
docs/superpowers/
